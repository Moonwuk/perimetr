{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "perimeter",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "perimeter-rooms",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../drizzle"
    }
  ],
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "10404101",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "ADMISSION_LIMITER",
      "namespace_id": "10404102",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}
